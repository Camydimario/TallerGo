package main

import (
	"fmt"
	"strings"
)

func SonAnagramas(a, b string) bool {
	a = strings.ToLower(a)
	b = strings.ToLower(b)
	contarLetrasMapa1 := make(map[string]int)
	for _, valor := range a {
		contarLetrasMapa1[string(valor)]++
	}

	contarLetrasMapa2 := make(map[string]int)
	for _, valor := range b {
		contarLetrasMapa2[string(valor)]++
	}

	if len(contarLetrasMapa1) != len(contarLetrasMapa2) {
		return false
	}
	for letra, cantidad := range contarLetrasMapa1 {
		if contarLetrasMapa2[letra] != cantidad {
			return false
		}
	}

	return true
}

func main() {
	fmt.Println(SonAnagramas("roma", "amor")) // true
	fmt.Println(SonAnagramas("hola", "chau")) // false

}


