package main

import "fmt"

func ContarPalabras(texto string) map[string]int {
	contar := make(map[string]int)
	palabra := ""
	for _, letra := range texto {
		//contar[string(palabra)]++
		if letra == ' ' {
			if palabra != "" {
				contar[palabra]++
				palabra = ""
			}
		} else {
			palabra += string(letra)
		}
	}

	if palabra != "" {
		contar[palabra]++
	}

	return contar
}

func main() {
	texto := ContarPalabras("hola como estas")
	fmt.Print("El total de palabras es: ", texto)
	// Usá este espacio para probar tu implementación
}

