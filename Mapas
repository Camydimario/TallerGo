package main

import "fmt"

func Igual(a, b map[string]int) bool {
	sumarLetrasMapa1 := 0
	for _, valor := range a {
		sumarLetrasMapa1 = sumarLetrasMapa1 + valor
	}

	sumarLetrasMapa2 := 0
	for _, valor := range b {
		sumarLetrasMapa2 = sumarLetrasMapa2 + valor
	}
	if sumarLetrasMapa1 == sumarLetrasMapa2 {
		return true
	}

	return false

}

func main() {
	LetrasMapa1 := map[string]int{"a": 1, "b": 2}
	LetrasMapa2 := map[string]int{"a": 1, "b": 2}

	fmt.Print(Igual(LetrasMapa1, LetrasMapa2))

	LetrasMapa3 := map[string]int{"a": 2, "b": 2, "c": 3}
	LetrasMapa4 := map[string]int{"a": 1, "b": 2}

	fmt.Print(Igual(LetrasMapa3, LetrasMapa4))

}

