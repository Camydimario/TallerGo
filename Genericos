package main

import "fmt"

// OrdenarBurbuja ordena un slice usando el algoritmo de burbujeo.
// La función menor determina si a debe ir antes que b en el ordenamiento.
func OrdenarBurbuja[T any](arr []T, menor func(T, T) bool) {
	n := len(arr)
	for i := 0; i < n-1; i++ {
		for j := 0; j < n-1; j++ {
			if !menor(arr[j], arr[j+1]) {
				arr[j], arr[j+1] = arr[j+1], arr[j]

			}

		}

	}

}
func main() {
	numeros := []int{10, 22, 9, 25, 50, 5}
	OrdenarBurbuja(numeros, func(a, b int) bool {
		return a < b
	})
	fmt.Print(numeros)
}

