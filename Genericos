package main

import "fmt"

// Contiene verifica si un elemento está en el slice.
// Usa el constraint comparable para poder usar ==.
func Contiene[T comparable](arr []T, elem T) bool {
	for _, v := range arr {
		if v == elem {

			return true
		}
	}
	return false
}

// Posicion devuelve el índice de un elemento en el slice,
// o -1 si no está.
func Posicion[T comparable](arr []T, elem T) int {
	for i, v := range arr {
		if v == elem {
			return i
		}
	}
	return -1
}

func main() {
	numeros := []int{10, 20, 30, 40, 50, 60}
	fmt.Print(Contiene(numeros, 30))
	fmt.Print("\n")
	fmt.Print(Contiene(numeros, 70))
	fmt.Print("\n")
	fmt.Print(Posicion(numeros, 10))
	fmt.Print("\n")
	fmt.Print(Posicion(numeros, 32))
}

