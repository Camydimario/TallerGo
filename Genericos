package main

import "fmt"

// Filtrar devuelve un nuevo slice con los elementos que cumplen la condición.
// La función fn recibe un elemento y devuelve true si debe conservarlo.
func Filtrar[T any](arr []T, fn func(T) bool) []T {
	// 1. Contamos cuántos elementos cumplen la condición
	cantidad := 0
	for _, v := range arr {
		if fn(v) {
			cantidad++
		}
	}

	filtrar := make([]T, cantidad)
	marcador := 0
	for _, v := range arr {
		if fn(v) {
			filtrar[marcador] = v
			marcador++
		}
	}

	return filtrar
}

func main() {
	numeros := []int{2, 4, 7, 9, 10}
	numerosFiltrados := Filtrar(numeros, func(a int) bool {
		return a%2 == 0
	})
	fmt.Print("arrays", numeros)
	fmt.Print("\nArrays con filtrado", numerosFiltrados)
}

