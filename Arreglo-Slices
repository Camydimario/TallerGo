//invertir
package main

import "fmt"

func Invertir(s []int) {

	for i, j := 0, len(s)-1; i < j; i, j = i+1, j-1 {
		s[i], s[j] = s[j], s[i]
	}

}

func main() {
	numeros := []int{1, 2, 3, 4, 5}
	fmt.Println("original", numeros)
	Invertir(numeros[:])
	fmt.Println("invertido", numeros)

	// Usá este espacio para probar tu implementación
}

// rotar
package main

import "fmt"

func Rotar(s []int, k int) {
	if len(s) == 0 {
		return
	}

	for i := 0; i < k; i++ {
		for i := 0; i < len(s)-1; i++ {
			s[i], s[i+1] = s[i+1], s[i]
		}

	}
}

func Invertir(s []int) {
	for i, j := 0, len(s)-1; i < j; i, j = i+1, j-1 {
		s[i], s[j] = s[j], s[i]
	}
}

func main() {

	fmt.Print("Rotacion")
	numeros := []int{1, 2, 3, 4, 5, 6}
	fmt.Println("Arreglo sin rotar", numeros)
	Rotar(numeros[:], 1)
	fmt.Println("Arreglo rotado", numeros)

	//invertir
	fmt.Print("Ivertir")
	numeros2 := []int{1, 2, 3, 4}
	fmt.Println("Arreglo sin invertir", numeros2)
	Invertir(numeros2[:])
	fmt.Println("Arreglo invertido", numeros2)
}


// eliminar
package main

import "fmt"

func Eliminar(s []int, pos int) []int {
	if pos < 0 || pos > len(s) {
		return s
	}
	for i := pos; i < len(s)-1; i++ {
		s[i] = s[i+1]
	}
	return s[:len(s)-1]

}

func main() {
	numeros := []int{1, 2, 3, 4, 5, 6}
	fmt.Print("Numeros originales\n", numeros)
	posicion := 2
	numeros = Eliminar(numeros, posicion)
	fmt.Printf("Se elimino la posicion %d y quedo asi: %v \n", posicion, numeros)

	// borrar para la entrega
	numeros2 := []int{1, 2, 3}
	fmt.Print("Arreglo original", numeros2)

	numeros2 = Eliminar(numeros2, 1)
	fmt.Print("Nuevo arreglo", numeros2)

}

//eliminar duplicados
package main

import "fmt"

func EliminarDuplicados(s []int) []int {

	if len(s) == 0 {
		return s
	}
	resultado := 0
	for i := 0; i < len(s); i++ {
		duplicado := false

		for j := 0; j < resultado; j++ {
			if s[i] == s[j] {
				duplicado = true
				break

			}
		}

		if !duplicado {
			s[resultado] = s[i]
			resultado++
		}
	}

	return s[:resultado]

}

func main() {
	numeros := []int{1, 2, 3, 4, 4, 5}
	fmt.Print("Original", numeros)
	numeros = EliminarDuplicados(numeros)
	fmt.Print("Lista nueva sin duplicados", numeros)

	// Usá este espacio para probar tu implementación
}

