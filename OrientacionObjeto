package empleados

type MedioTiempo struct {
	nombre          string
	puesto          string
	sueldoPorHora   float64
	horasTrabajadas int
}

func NewMedioTiempo(nombre string, puesto string, sueldoPorHora float64, horasTrabajadas int) *MedioTiempo {
	return &MedioTiempo{
		nombre:          nombre,
		puesto:          puesto,
		sueldoPorHora:   sueldoPorHora,
		horasTrabajadas: horasTrabajadas,
	}

}

func (e *MedioTiempo) CalcularSueldo() float64 {
	return e.sueldoPorHora * float64(e.horasTrabajadas)
}

func (e *MedioTiempo) Puesto() string {
	//return fmt.Sprintf("el puesto es el siguiente %s \n", e.puesto)
	return e.puesto
}

func (e *MedioTiempo) Nombre() string {
	//return fmt.Sprintf("el nombre es el siguiente %s \n", e.nombre)
	return e.nombre
}


//comision por hora
package empleados

import "fmt"

type PorComision struct {
	nombre             string
	puesto             string
	sueldoBase         float64
	ventasRealizadas   float64
	porcentajeComision float64
}

func NewPorComision(nombre string, puesto string, sueldoBase, ventasRealizadas, porcentajeComision float64) *PorComision {
	return &PorComision{
		nombre:             nombre,
		puesto:             puesto,
		sueldoBase:         sueldoBase,
		ventasRealizadas:   ventasRealizadas,
		porcentajeComision: porcentajeComision,
	}

}

func (e *PorComision) CalcularSueldo() float64 {
	calculoDeComision := e.ventasRealizadas * (float64(e.porcentajeComision))

	return e.sueldoBase + calculoDeComision
}

func (e *PorComision) Puesto() string {
	return fmt.Sprintf("el puesto es el siguiente %s\n", e.puesto)
}

func (e *PorComision) Nombre() string {
	return fmt.Sprintf("el nombre es el siguiente %s\n", e.nombre)
}

