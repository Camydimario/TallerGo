//Gerente
package empleados

type Gerente struct {
	TiempoCompleto
	bono float64
}

func NewGerente(nombre string, sueldoMensual float64, bono float64) *Gerente {
	return &Gerente{
		TiempoCompleto: TiempoCompleto{
			nombre:        nombre,
			sueldoMensual: sueldoMensual,
		},
		bono: bono,
	}
}

func (e *Gerente) CalcularSueldo() float64 {
	sueldoFinal := e.sueldoMensual + e.bono
	return sueldoFinal

}

func (e *Gerente) Puesto() string {
	//return fmt.Sprintf("El puesto del gerente es el siguiente %s\n", e.puesto)
	return "Gerente"
}


