package main

import (
	"fmt"
)

type SaldoInsuficienteError struct {
	Saldo float64
	Monto float64
}

//var errorSaldo = errors.New("Saldo insuficiente")

// TODO: implementar el método Error() para que SaldoInsuficienteError implemente error

func (s SaldoInsuficienteError) Error() string {
	return fmt.Sprintf("error el saldo es de %.2f, y el monto pedido es de %.2f\n", s.Monto, s.Saldo)
}

func Extraer(saldo, monto float64) (float64, error) {
	if saldo < monto {
		return saldo, SaldoInsuficienteError{
			Saldo: saldo,
			Monto: monto,
		}
	}
	return saldo - monto, nil
}

func main() {
	saldoFinal, err := Extraer(100.0, 50.0)
	if err != nil {
		fmt.Print(err)
	} else {
		fmt.Print("operacion exitosa, el saldo quedo en $", saldoFinal)
	}
}

//Leer archivos
package main

import (
	"bufio"
	"fmt"
	"os"
)

func LeerArchivo(ruta string) (string, error) {

	archivoParaLerr, err := os.Open(ruta)
	if err != nil {
		return "", err
	}

	defer archivoParaLerr.Close()
	var contenido string
	scanner := bufio.NewScanner(archivoParaLerr)
	for scanner.Scan() {
		contenido += scanner.Text()

	}
	if err := scanner.Err(); err != nil {
		return "", err
	}

	return contenido, nil
}

func main() {
	nombreDelArchivo := "_test.txt"
	contenido := []byte("Hola que tal todo bien?")
	//os.WriteFile("_test.txt", []byte("hola"), 0644)
	//defer os.Remove("_test.txt")
	err := os.WriteFile(nombreDelArchivo, contenido, 0644)
	if err != nil {
		fmt.Print("Error al leer el archivo", err)
		return
	}
	defer os.Remove(nombreDelArchivo)
	resultadoFinal, err := LeerArchivo(nombreDelArchivo)
	if err != nil {
		fmt.Println("Error al leer el archivo:", err)
		return
	}
	fmt.Print("Contenido leído:\n", resultadoFinal)

}
