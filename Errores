//dividir

package main

import (
	"errors"
	"fmt"
)

func Dividir(a, b float64) (float64, error) {

	dividendo := a
	divisor := b
	if divisor == 0 {
		return 0, errors.New("Division por cero, no es valido")
	}
	resultado := dividendo / divisor

	return resultado, nil
}

func main() {

	resultado, err := Dividir(20, 2)
	if err != nil {
		fmt.Println("Error:", err)
		return
	}
	fmt.Print(err, resultado)
}

//clasificar
package main

import (
	"errors"
	"fmt"
)

func ClasificarEdad(edad int) (string, error) {

	if edad < 0 {
		return "", errors.New("esa edad no existe")
	}

	if edad >= 18 {

		return "adulto", nil
	}
	if edad >= 12 {
		return "adolescente", nil
	}
	if edad >= 0 {
		return "nino", nil
	}

	return "", nil
}

func main() {
	categoria, err := ClasificarEdad(20)
	if err != nil {
		fmt.Println("Error:", err)
		return
	}
	fmt.Println("Resultado:", categoria)
}


//buscarProductos
package main

import (
	"errors"
	"fmt"
)

type Producto struct {
	Codigo int
	Nombre string
}

var ErrProductoNoEncontrado = errors.New("producto no encontrado")

func BuscarProducto(productos []Producto, codigo int) (Producto, error) {
	for _, p := range productos {
		if p.Codigo == codigo {
			return p, nil
		}

	}

	return Producto{}, ErrProductoNoEncontrado
}

func main() {
	productos := []Producto{

		{Codigo: 123, Nombre: "tomate"},
		{Codigo: 456, Nombre: "lechuga"},
		{Codigo: 122, Nombre: "cebolla"},
		{Codigo: 240, Nombre: "acelga"},
	}

	producto, err := BuscarProducto(productos, 24)
	if err == ErrProductoNoEncontrado {
		fmt.Print("producto no encontrado")
		return
	}
	fmt.Println("Producto encontrado:", producto.Nombre)
}

