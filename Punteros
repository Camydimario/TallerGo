//swap
package main

import "fmt"

func Swap(a, b *int) {
	*a, *b = *b, *a
}

func main() {
	numeroA := 30
	numeroB := 10
	fmt.Print("numero antes del swap: ", numeroA, numeroB)
	Swap(&numeroA, &numeroB)
	fmt.Print("\nnumero despues del swap: ", numeroA, numeroB)

}

// sumar Punteros 
package main

import (
	"fmt"
)

func SumarPunteros(a, b *int) int {
	cero := 0

	if a == nil {
		a = &cero
	}
	if b == nil {
		b = &cero
	}

	resultado := *a + *b

	return resultado
}

func main() {
	numeroA := 10
	numeroB := 20
	fmt.Print(SumarPunteros(&numeroA, &numeroB))

}

//dividir
package main

import "fmt"

func Dividir(dividendo, divisor int, resto *int) int {

	numeroA := dividendo
	numeroB := divisor

	if numeroB == 0 {
		return 0
	}
	*resto = numeroA % numeroB
	resultado := numeroA / numeroB

	return resultado
}

func main() {
	numeroA := 10
	numeroB := 5
	var resto int // Declaramos la variable primero

	cociente := Dividir(numeroA, numeroB, &resto)

	fmt.Println("Cociente:", cociente)
	fmt.Println("Resto:", resto)
}

//inicializar arreglos
package main

import "fmt"

func InicializarArreglo(arr *[5]int) {
	if arr == nil {
		return
	}
	for i := range arr {
		arr[i] = i * 2
	}
}

func main() {
	numeros := [5]int{1, 3, 4, 5, 6}
	InicializarArreglo(&numeros)
	fmt.Print((numeros))

}

//concatenar
package main

import "fmt"

func Concatenar(destino *string, sufijo string) {
	if destino == nil {
		return
	}

	primeraParte := destino
	segundaParte := sufijo

	*destino = *primeraParte + segundaParte

}

func main() {
	textoUno := "hola"
	Concatenar(&textoUno, " Todo bien?")
	fmt.Print(textoUno)
}
